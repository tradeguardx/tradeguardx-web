{
  "redirects": [
    {
      "source": "/exchanges/bybit",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/exchanges/bitget",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/help/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/:slug",
      "destination": "/help/:slug",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/help",
      "permanent": true
    },
    {
      "source": "/prop-firm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/beta-traders",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/beta-testers",
      "destination": "/signup",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?:pricing|signup|exchanges|exchanges/delta|exchanges/delta/api-key|exchanges/coindcx|exchanges/coindcx/api-key|exchanges/coindcx/margin|exchanges/shark|exchanges/shark/api-key|crypto-kill-switch|crypto-tax-india|help|help/how-it-works|help/kill-switch|help/cooldowns|help/rules|help/changing-rules|help/live-dashboard|help/troubleshooting|security|about|roadmap|support|partner-with-us|privacy|terms|refund|risk-disclosure))",
      "destination": "/app.html"
    },
    {
      "source": "/((?:login|forgot-password|verify-email|reset-password|home-classic|reel-preview))",
      "destination": "/app.html"
    },
    {
      "source": "/((?:dashboard|influencer)(?:/.*)?)",
      "destination": "/app.html"
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
