{
  "redirects": [
    {
      "source": "/help/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/:slug",
      "destination": "/help/:slug",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/help",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
