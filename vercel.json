{
  "redirects": [
    {
      "source": "/exchanges/bybit",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/exchanges/bitget",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/help/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/:slug",
      "destination": "/help/:slug",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/help",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
