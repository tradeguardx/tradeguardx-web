{
  "redirects": [
    {
      "source": "/exchanges/bybit",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/exchanges/bitget",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/help/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/getting-started",
      "destination": "/exchanges",
      "permanent": true
    },
    {
      "source": "/docs/:slug",
      "destination": "/help/:slug",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/help",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?:about|beta-testers|beta-traders|crypto-kill-switch|crypto-tax-india|dashboard|docs|exchanges|forgot-password|help|home-classic|influencer|login|partner-with-us|pricing|privacy|prop-firm|reel-preview|refund|reset-password|risk-disclosure|roadmap|security|signup|support|terms|verify-email)(?:/.*)?)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
